# Copy to .env and adjust. Never commit the real .env.

KYRX_DATA_DIR=var
KYRX_TRANSPORT=stdio
KYRX_HOST=127.0.0.1
KYRX_PORT=8765
KYRX_STREAMABLE_HTTP_PATH=/mcp

# Remote fleets: "none" or "token"
KYRX_AUTH_MODE=none
# KYRX_AUTH_TOKEN=
# KYRX_AUTH_REQUIRED_SCOPES=["kyrx:write"]

# Small model used by the ambiguity router (OpenAI-compatible endpoint)
# KYRX_LLM_BASE_URL=http://127.0.0.1:1234/v1
# KYRX_LLM_MODEL=qwen3-4b
# KYRX_LLM_API_KEY=
KYRX_LLM_TIMEOUT_S=30

KYRX_LEASE_OFFER_TTL_S=5
KYRX_LEASE_RUN_TTL_S=20
KYRX_LEASE_HEARTBEAT_S=5
KYRX_LEASE_STEAL_AFTER_S=30

KYRX_SANDBOX_TIMEOUT_S=30
KYRX_SANDBOX_MEMORY_BYTES=67108864
KYRX_SANDBOX_FUEL=200000000
